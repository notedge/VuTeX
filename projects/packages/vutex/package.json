{
    "name": "@vutex/vutex",
    "version": "0.0.0",
    "description": "VuTeX: language-neutral document typesetting runtime and official CLI",
    "type": "module",
    "license": "MPL-2.0",
    "publishConfig": {
        "access": "public"
    },
    "bin": {
        "vutex": "bin/vutex.mjs"
    },
    "exports": {
        ".": "./src/index.ts",
        "./node": "./src/node/index.ts",
        "./cli": "./src/cli/main.ts"
    },
    "files": [
        "bin",
        "locales",
        "readme.md",
        "src"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/package-manager.test.ts"
    },
    "dependencies": {
        "@iarna/toml": "^2.2.5",
        "@vmz/commander": "^0.2.0",
        "jiti": "^2.4.2"
    },
    "optionalDependencies": {
        "@vutex/vutex-darwin-arm64": "workspace:*",
        "@vutex/vutex-darwin-x64": "workspace:*",
        "@vutex/vutex-linux-arm64": "workspace:*",
        "@vutex/vutex-linux-x64": "workspace:*",
        "@vutex/vutex-win32-x64": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3"
    }
}
