    {
      "src": "a + b",
      "group": "arithmetic",
      "style": "text",
      "expected": "layout",
      "diagnostics": false,
      "invariants": ["glyph_count", "ink_in_viewbox", "no_text", "positive_metrics"]
    },
    {
      "src": "a - b",
      "group": "arithmetic",
