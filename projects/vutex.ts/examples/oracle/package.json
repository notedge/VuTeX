{
  "name": "@vutex/oracle-tools",
  "version": "0.0.0",
  "private": true,
  "description": "External-oracle generators for the VuTeX layout corpus.",
  "type": "module",
  "scripts": {
    "katex:mathml": "node emit-katex-mathml.mjs",
    "mathjax:mathml": "node emit-mathjax-mathml.mjs",
    "mathjax:svg": "node emit-mathjax-svg.mjs",
    "latex:probe": "node probe-latex.mjs",
    "latex:boxes": "node emit-latex-boxes.mjs",
    "render:watex": "pnpm --filter @vutex/watex build && node render-watex.mjs"
  },
  "dependencies": {
    "@vutex/vutex-unknown-wasm32": "workspace:*",
    "@vutex/watex": "workspace:*"
  },
  "devDependencies": {
    "katex": "0.16.22",
    "mathjax": "^3.2.2"
  }
}
