{
    "name": "@vutex/homepage",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "description": "VuTeX official site — landing, formula gallery and playground",
    "license": "MPL-2.0",
    "scripts": {
        "check": "pnpm --filter @vutex/wetex run build && vmz check .",
        "dev": "pnpm --filter @vutex/wetex run build && vmz dev .",
        "build": "pnpm --filter @vutex/wetex run build && vmz build .",
        "serve": "vmz serve ."
    },
    "dependencies": {
        "@mathjax/src": "4.1.3",
        "@vmz/ui": "0.3.12",
        "@vmz/ui-icons": "0.3.12",
        "@vutex/wetex": "workspace:*",
        "katex": "0.18.4"
    },
    "devDependencies": {
        "@vmz/plugin-markdown-it": "0.3.12",
        "@vmz/vmz": "0.3.12"
    }
}
