<template>
    <footer class="site-footer" data-vmz-fixture="site-footer"><div class="container">
        <div class="site-footer__grid"><div class="site-footer__brand"><a :href="href('/')" class="site-brand">VuTeX</a><p>{{ t('footer') }}</p></div><div class="site-footer__group"><b>{{ t('site') }}</b><a :href="href('/gallery')">{{ t('gallery') }}</a><a :href="href('/playground')">{{ t('playground') }}</a><a :href="href('/welcome')">{{ t('fullscreen') }}</a></div><div class="site-footer__group"><b>{{ t('project') }}</b><a href="https://github.com/notedge/VuTeX" target="_blank" rel="noreferrer noopener">GitHub ↗</a><a href="https://www.npmjs.com/package/@vutex/wetex" target="_blank" rel="noreferrer noopener">WeTeX / npm ↗</a></div></div>
        <div class="site-footer__colophon"><span lang="en">VuTeX © 2026</span><span>{{ t('colophon') }}</span><span lang="en">BUILT WITH VMZ</span></div>
    </div></footer>
</template>
<script client>
import { copy, readLocale, localizedHref } from "../lib/locale.ts";
export default class SiteFooter {
    locale = "zh-hans";
    onMount() { this.locale = readLocale(); }
    t(key) { return copy(key, this.locale); }
    href(path) { return localizedHref(path, this.locale); }
}
