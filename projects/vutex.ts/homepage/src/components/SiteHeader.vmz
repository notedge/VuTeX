<template>
    <header class="site-header" data-vmz-fixture="site-header">
        <div class="container site-header__inner">
            <a :href="href('/')" class="site-brand" aria-label="VuTeX"><span>VuTeX</span><span class="site-brand__descriptor" lang="en">TYPESETTING ATELIER</span></a>
            <nav class="site-nav" :aria-label="t('overview')">
                <div class="site-nav__links"><a :href="href('/')" :aria-current="page === 'index' ? 'page' : null">{{ t('overview') }}</a><a :href="href('/gallery')" :aria-current="page === 'gallery' ? 'page' : null">{{ t('gallery') }}</a><a :href="href('/playground')" :aria-current="page === 'playground' ? 'page' : null">{{ t('playground') }}</a><a :href="href('/install')">{{ t('install') }}</a><a :href="href('/d')">{{ t('docs') }}</a></div>
                <div class="site-nav__tools">
                    <details class="site-language"><summary class="icon-button" :aria-label="t('language')" :title="t('language')"><Icon name="nav.language" size="md" decorative /></summary><div class="site-popover"><a :href="localeHref('zh-hans')" lang="zh-CN" :aria-current="locale === 'zh-hans' ? 'true' : null">简体中文<span>ZH</span></a><a :href="localeHref('en-us')" lang="en" :aria-current="locale === 'en-us' ? 'true' : null">English<span>EN</span></a></div></details>
                    <a class="site-nav__github" href="https://github.com/notedge/VuTeX" target="_blank" rel="noreferrer noopener">GitHub<span aria-hidden="true">↗</span></a>
                    <details class="site-menu"><summary class="icon-button" :aria-label="t('menu')"><Icon name="action.menu" size="md" decorative /></summary><div class="site-popover"><a :href="href('/')">{{ t('overview') }}</a><a :href="href('/gallery')">{{ t('gallery') }}</a><a :href="href('/playground')">{{ t('playground') }}</a><a :href="href('/install')">{{ t('install') }}</a><a :href="href('/d')">{{ t('docs') }}</a><a href="https://github.com/notedge/VuTeX" target="_blank" rel="noreferrer noopener">GitHub ↗</a></div></details>
                </div>
            </nav>
        </div>
    </header>
</template>
<script client>
import { copy, readLocale, localizedHref } from "../lib/locale.ts";
export default class SiteHeader {
    page = "";
    locale = "zh-hans";
    onMount() { this.locale = readLocale(); }
    t(key) { return copy(key, this.locale); }
    href(path) { return localizedHref(path, this.locale); }
    localeHref(locale) {
        const path = { index: "/", gallery: "/gallery", playground: "/playground", install: "/install", welcome: "/welcome" }[this.page] || "/";
        return localizedHref(path, locale);
    }
}
</script>
