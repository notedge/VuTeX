<template>
    <SiteShell page="index">
        <section class="book-hero">
            <div class="container book-hero__frame">
                <div class="folio rise"><span lang="en">VuTeX — Typesetting Engine</span><span lang="en">Folio 1</span></div>
                <div class="galley rise d1">
                    <h1>{{ t('heroTitleA') }}<br />{{ t('heroTitleB') }}</h1>
                    <p class="standfirst" lang="en">{{ t('heroStandfirst') }}</p>
                    <p class="body">{{ t('heroBody') }}</p>
                    <div class="galley__actions">
                        <a :href="href('/d')" class="btn btn--primary">{{ t('readDocs') }}</a>
                        <a :href="href('/playground')" class="text-link">{{ t('openPlayground') }}<span class="link-arrow" aria-hidden="true">→</span></a>
                    </div>
                    <div class="press-row">
                        <p class="colophon" lang="en"><span>{{ t('colophonType') }}</span><span>{{ t('colophonMeasure') }}</span></p>
                        <div class="seal" role="img" :aria-label="t('sealLabel')">印</div>
                    </div>
                </div>
            </div>
        </section>

        <section class="pipeline">
            <div class="container">
                <p class="label label--on-night">{{ t('pipelineOver') }}</p>
                <h2>{{ t('pipelineTitleA') }}<br />{{ t('pipelineTitleB') }}</h2>
                <p class="pipeline__text">{{ t('pipelineText') }}</p>
                <div class="pipeline__grid">
                    <figure class="panel">
                        <figcaption class="panel__head"><span>{{ t('pipelineCli') }}</span><span lang="en">vutex</span></figcaption>
                        <pre class="panel__code"><code>{{ cliScript }}</code></pre>
                    </figure>
                    <figure class="panel">
                        <figcaption class="panel__head"><span>{{ t('pipelineLive') }}</span><span lang="en">WaTeX · SVG · Latin Modern</span></figcaption>
                        <div class="panel__formula" v-html="heroMarkup"></div>
                        <p class="panel__note">{{ liveStatus() }}</p>
                        <dl class="panel__metrics">
                            <div><dt>{{ t('metricWidth') }}</dt><dd lang="en">{{ metric('width') }}</dd></div>
                            <div><dt>{{ t('metricHeight') }}</dt><dd lang="en">{{ metric('height') }}</dd></div>
                            <div><dt>{{ t('metricDepth') }}</dt><dd lang="en">{{ metric('depth') }}</dd></div>
                            <div><dt>{{ t('metricBaseline') }}</dt><dd lang="en">{{ metric('baseline') }}</dd></div>
                        </dl>
                    </figure>
                </div>
            </div>
        </section>

        <section class="discipline container">
            <p class="label">{{ t('typeOver') }}</p>
            <h2>{{ t('typeTitle') }}</h2>
            <p class="lede">{{ t('typeText') }}</p>
            <dl class="spec-list">
                <div class="spec-list__row"><dt>{{ t('specMeasure') }}<span lang="en">Measure</span></dt><dd class="spec-list__value" lang="en">34em</dd><dd class="spec-list__note">{{ t('specMeasureNote') }}</dd></div>
                <div class="spec-list__row"><dt>{{ t('specBaseline') }}<span lang="en">Baseline</span></dt><dd class="spec-list__value" lang="en">28px</dd><dd class="spec-list__note">{{ t('specBaselineNote') }}</dd></div>
                <div class="spec-list__row"><dt>{{ t('specHead') }}<span lang="en">Running head</span></dt><dd class="spec-list__value" lang="en">12px</dd><dd class="spec-list__note">{{ t('specHeadNote') }}</dd></div>
                <div class="spec-list__row"><dt>{{ t('specHairline') }}<span lang="en">Hairline</span></dt><dd class="spec-list__value" lang="en">1px</dd><dd class="spec-list__note">{{ t('specHairlineNote') }}</dd></div>
                <div class="spec-list__row"><dt>{{ t('specSeal') }}<span lang="en">Seal</span></dt><dd class="spec-list__value spec-list__value--seal" lang="en">#B5382A</dd><dd class="spec-list__note">{{ t('specSealNote') }}</dd></div>
            </dl>
            <a :href="href('/gallery')" class="text-link">{{ t('compareEngines') }}<span class="link-arrow" aria-hidden="true">→</span></a>
        </section>

        <section class="install-band">
            <div class="container">
                <p class="label label--on-night">{{ t('installOver') }}</p>
                <h2>{{ t('installTitle') }}</h2>
                <div class="install-band__grid">
                    <article><span class="install-band__index" lang="en">01 · Formula</span><h3>{{ t('installWatex') }}</h3><p>{{ t('installWatexText') }}</p><pre><code>pnpm add @vutex/watex</code></pre></article>
                    <article><span class="install-band__index" lang="en">02 · Runtime + CLI</span><h3>{{ t('installRuntime') }}</h3><p>{{ t('installRuntimeText') }}</p><pre><code>pnpm add @vutex/vutex
pnpm exec vutex --help</code></pre></article>
                </div>
                <div class="install-band__foot">
                    <p>{{ t('installRequirements') }}</p>
                    <a :href="href('/install')" class="btn btn--on-night">{{ t('installDocsLink') }}</a>
                </div>
            </div>
        </section>
    </SiteShell>
</template>
<script client>
import { renderMeasured } from "../lib/engines.ts";
import { SPECIMENS } from "../lib/formulas.ts";
import { copy, readLocale, localizedHref } from "../lib/locale.ts";
export default class Index {
    locale = "zh-hans";
    heroMarkup = "";
    metrics = null;
    liveFailed = false;
    liveNote = "";
    cliScript = "$ pnpm add @vutex/vutex\n$ vutex inspect chapter.tex\ntex        chapter.tex\n$ vutex render chapter.tex --output pdf\nchapter.pdf";
    t(key) { return copy(key, this.locale); }
    href(path) { return localizedHref(path, this.locale); }
    metric(name) {
        const value = this.metrics && typeof this.metrics[name] === "number" ? this.metrics[name] : null;
        return value === null ? "—" : `${value.toFixed(2)}px`;
    }
    liveStatus() { return this.liveFailed && this.liveNote ? this.liveNote : this.t("pipelineLiveNote"); }
    onMount() {
        this.locale = readLocale();
        document.documentElement.lang = this.locale === "en-us" ? "en" : "zh-CN";
        document.title = this.locale === "en-us"
            ? "VuTeX — Semantic documents in, measurable pages out"
            : "VuTeX — 语义文档进，可测量的页面出";
        this.renderSpecimen();
    }
    async renderSpecimen() {
        const result = await renderMeasured(SPECIMENS[0].tex);
        this.heroMarkup = result.ok ? result.markup : "";
        this.metrics = result.ok ? result.metrics : null;
        this.liveFailed = !result.ok;
        this.liveNote = result.note;
    }
}
</script>
