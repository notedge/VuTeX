<template>
    <SiteShell page="index">
        <section class="container hero">
            <div class="hero__copy">
                <p class="label label--accent">VuTeX · WeTeX</p>
                <h1>
                    公式排版，
                    <br />
                    <em>本来该算出来，不该拿 CSS 猜。</em>
                </h1>
                <p class="lede">
                    WeTeX 是 VuTeX 的排版内核：Rust 实现，编译成 WASM，在浏览器里算出每个字形的宽度、高度与基线深度，再落成 SVG 或 MathML。这个页面上的公式，都是它当场排出来的。
                </p>
                <div class="hero__actions">
                    <a href="/gallery" class="btn btn--primary">看它排得怎么样</a>
                    <a href="/playground" class="btn">
                        自己写一段
                        <span aria-hidden="true">→</span>
                    </a>
                </div>
            </div>
            <div class="hero__specimen">
                <div class="hero__canvas" v-html="heroMarkup"></div>
                <p class="hero__caption">
                    <span class="meta">WeTeX · SVG</span>
                    <span class="hero__metric">{{ heroMetric }}</span>
                </p>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <p class="label">为什么重写一遍</p>
                <div class="principles">
                    <article class="principle">
                        <span class="meta">01</span>
                        <h2>度量，而不只是显示</h2>
                        <p>
                            宽、高、基线深度与深度（depth）由内核直接返回。分页、对齐、自动换行这些排版问题因此可以用数字解决，而不是用 CSS 猜。
                        </p>
                    </article>
                    <article class="principle">
                        <span class="meta">02</span>
                        <h2>一份语义，两种产物</h2>
                        <p>
                            同一棵公式树可以落到 SVG 路径，也可以落到 MathML 语义。选择格式是交付决定，不是重写公式。
                        </p>
                    </article>
                    <article class="principle">
                        <span class="meta">03</span>
                        <h2>拿成熟实现做参照</h2>
                        <p>
                            KaTeX 与 MathJax 在这里只当参照组：同一份 TeX 跑三遍，逐条看 WeTeX 排得对不对。差异写进画廊，不写进宣传语。
                        </p>
                    </article>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container">
                <p class="label">输出格式</p>
                <h2 class="section__title">WeTeX 给的是 SVG 与 MathML</h2>
                <table class="matrix">
                    <thead>
                        <tr>
                            <th scope="col">引擎</th>
                            <th scope="col" v-for="backend in backends" :key="backend.id">{{ backend.label }}</th>
                            <th scope="col">来源</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="engine in engines" :key="engine.id">
                            <td>
                                <span class="matrix__name">{{ engine.name }}</span>
                            </td>
                            <td v-for="backend in backends" :key="backend.id">
                                <span :data-on="supports(engine.id, backend.id) ? 'true' : 'false'">
                                    {{ mark(engine.id, backend.id) }}
                                </span>
                            </td>
                            <td class="meta">{{ engine.vendor }}</td>
                        </tr>
                    </tbody>
                </table>
                <p class="matrix__note">
                    WeTeX 同时出 SVG 与 MathML。表里另外两行是参照：KaTeX 出 HTML 与 MathML，MathJax 出 SVG 与 MathML；HTML 只有 KaTeX 提供。
                </p>
            </div>
        </section>

        <section class="section">
            <div class="container closing">
                <p class="label label--accent">继续</p>
                <h2 class="closing__title">先看这 14 条公式，再拿自己的 TeX 试一遍。</h2>
                <div class="closing__actions">
                    <a href="/welcome" class="btn btn--primary">全屏逐条看</a>
                    <a href="/playground" class="btn">打开试验台</a>
                </div>
            </div>
        </section>
    </SiteShell>
</template>
<script client>
import { BACKENDS, ENGINES, renderFormula, supportsBackend } from "../lib/engines.ts";
import { SPECIMENS } from "../lib/formulas.ts";

export default class Index {
    backends = BACKENDS.slice();
    engines = ENGINES.slice();
    heroMarkup = "";
    heroMetric = "编译中";

    onMount() {
        this.renderHero();
    }

    supports(engineId, backendId) {
        return supportsBackend(engineId, backendId);
    }

    mark(engineId, backendId) {
        return supportsBackend(engineId, backendId) ? "✓" : "—";
    }

    async renderHero() {
        const item = SPECIMENS[6];
        const result = await renderFormula("wetex", "svg", item.tex, true);
        this.heroMarkup = result.ok ? result.markup : "";
        this.heroMetric = `${item.name} · ${result.ms} ms`;
    }
}
</script>
