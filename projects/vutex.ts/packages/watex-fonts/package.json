{
    "name": "@vutex/watex-fonts",
    "version": "0.0.18",
    "description": "WaTeX bundled math font assets for browser and Node",
    "type": "module",
    "license": "SEE LICENSE IN assets/fonts",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/notedge/VuTeX.git",
        "directory": "projects/vutex.ts/packages/watex-fonts"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "node": "./node.js",
            "default": "./browser.js"
        },
        "./package.json": "./package.json",
        "./fonts.json": "./assets/fonts/fonts.json",
        "./fonts/*": "./assets/fonts/*"
    },
    "files": [
        "assets",
        "browser.js",
        "index.d.ts",
        "node.js",
        "readme.md"
    ],
    "scripts": {
        "prepack": "node ../../../../scripts/fonts/stage.mjs"
    }
}
