{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true
    },
    "include": ["src/**/*.ts", "tests/**/*.ts"]
}
