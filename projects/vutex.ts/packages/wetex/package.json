{
    "name": "@vutex/wetex",
    "version": "0.0.13",
    "description": "WeTeX: VuTeX formula rendering for browser and Node (Rust/WASM)",
    "type": "module",
    "license": "MPL-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/notedge/VuTeX.git",
        "directory": "projects/vutex.ts/packages/wetex"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": "./dist/index.js",
        "./wasm": "./dist/wasm/index.js"
    },
    "files": [
        "readme.md",
        "dist"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "typecheck": "tsc --noEmit",
        "test": "tsx --test tests/smoke.test.ts tests/facade.test.ts"
    },
    "dependencies": {
        "@vutex/vutex-unknown-wasm32": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^22.13.10",
        "tsx": "^4.19.3",
        "typescript": "^5.8.3"
    }
}
